/* desk: wallpaper picker, a grid of thumbnails */
@import "config.rasi"
configuration { show-icons: true; }
window { width: 70%; }
listview { columns: 4; lines: 3; spacing: 10px; flow: horizontal; }
element { orientation: vertical; padding: 8px; spacing: 6px; }
element-icon { size: 200px; }
element-text { horizontal-align: 0.5; }
