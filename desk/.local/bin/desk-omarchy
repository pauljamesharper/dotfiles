#!/usr/bin/env python3
"""Import Omarchy's themes and wallpapers into desk; rerun to update.

Keeps a sparse checkout of Omarchy's themes/ in ~/.cache/desk/omarchy, turns
each themes/<id>/colors.toml into ~/.config/desk/themes/omarchy-<id>/ (the
theme.conf + foot-colors.ini pair desk-gen reads), copies its backgrounds to
~/.local/share/wallpapers/Omarchy/<id>-<name>, then runs desk-gen.
None of this is tracked in the dotfiles; it is all fetched.
"""
import shutil
import subprocess
import tomllib
from pathlib import Path

HOME = Path.home()
REPO_URL = "https://github.com/omacom/omarchy"
REPO = HOME / ".cache/desk/omarchy"
THEMES = HOME / ".config/desk/themes"
GEN = HOME / ".config/desk/generated"
WALLS = HOME / ".local/share/wallpapers/Omarchy"
ICON_DIRS = [HOME / ".local/share/icons", HOME / ".icons", Path("/usr/share/icons")]
SPARSE = ["/themes/*/colors.toml", "/themes/*/icons.theme", "/themes/*/backgrounds/*",
          "!/themes/*/backgrounds/intros/"]


def git(*args):
    subprocess.run(["git", "-C", str(REPO), *args], check=True)


def sync_repo():
    if not (REPO / ".git").exists():
        REPO.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["git", "clone", "--depth", "1", "--filter=blob:none", "--no-checkout",
                        REPO_URL, str(REPO)], check=True)
        git("sparse-checkout", "set", "--no-cone", *SPARSE)
        git("checkout")
    else:
        git("fetch", "--depth", "1", "origin")
        git("reset", "--hard", "FETCH_HEAD")


def mix(a, b, t):
    ra = [int(a[i:i + 2], 16) for i in (1, 3, 5)]
    rb = [int(b[i:i + 2], 16) for i in (1, 3, 5)]
    return "#" + "".join(f"{round(x + (y - x) * t):02x}" for x, y in zip(ra, rb))


def resolve(c):
    """The subset of omarchy-theme-color's fallback cascade that desk needs."""
    c = {k: v.lower() for k, v in c.items() if isinstance(v, str)}
    c.setdefault("magenta", c.get("purple"))
    c.setdefault("lighter_background", c["background"])
    c.setdefault("bright_foreground", c["foreground"])
    c.setdefault("muted", c.get("dark_foreground", c["foreground"]))
    c.setdefault("selection", c["muted"])
    c.setdefault("selection_foreground", c["bright_foreground"])
    for n in ("red", "yellow", "green", "cyan", "blue", "magenta"):
        c.setdefault(f"bright_{n}", mix(c[n], "#ffffff", 0.2))
    if "mode" not in c:
        rgb = [int(c["background"][i:i + 2], 16) for i in (1, 3, 5)]
        c["mode"] = "light" if sum(rgb) > 382 else "dark"
    return c


def icon_theme(name, dark):
    """Omarchy names Yaru accents; prefer their -dark flavour on dark themes."""
    def installed(n):
        return any((d / n / "index.theme").exists() for d in ICON_DIRS)
    for cand in ([f"{name}-dark"] if dark else []) + [name, "Yaru-dark" if dark else "Yaru"]:
        if cand and installed(cand):
            return cand
    return "breeze-dark" if dark else "breeze"


def import_theme(src):
    tid = src.name
    c = resolve(tomllib.loads((src / "colors.toml").read_text()))
    dark = c["mode"] != "light"
    icons_file = src / "icons.theme"
    icons = icon_theme(icons_file.read_text().split()[0] if icons_file.exists() else "", dark)
    accent = c["accent"]
    secondary = c["blue"] if c["blue"] != accent else c["cyan"]
    name = " ".join(w.capitalize() for w in tid.split("-")) + " (Omarchy)"

    out = THEMES / f"omarchy-{tid}"
    out.mkdir(parents=True, exist_ok=True)
    (out / "theme.conf").write_text(
        f"# Generated by desk-omarchy from Omarchy's themes/{tid}/colors.toml\n"
        f"name = {name}\n\ngtk       = Breeze\nicons     = {icons}\n\n"
        f"bg        = {c['background']}\nbg_alt    = {c['lighter_background']}\n"
        f"fg        = {c['foreground']}\nprimary   = {accent}\nsecondary = {secondary}\n"
        f"disabled  = {c['muted']}\nalert     = {c['red']}\n")
    # Same ANSI layout as Omarchy's own foot.ini.tpl
    regular = ["background", "red", "green", "yellow", "blue", "magenta", "cyan", "foreground"]
    bright = ["muted", "bright_red", "bright_green", "bright_yellow", "bright_blue",
              "bright_magenta", "bright_cyan", "bright_foreground"]
    lines = ["[colors]", f"foreground = {c['foreground'][1:]}", f"background = {c['background'][1:]}", ""]
    lines += [f"regular{i} = {c[k][1:]}" for i, k in enumerate(regular)] + [""]
    lines += [f"bright{i} = {c[k][1:]}" for i, k in enumerate(bright)] + [""]
    lines += [f"selection-foreground = {c['selection_foreground'][1:]}",
              f"selection-background = {c['selection'][1:]}"]
    (out / "foot-colors.ini").write_text("\n".join(lines) + "\n")

    walls = []
    for f in sorted((src / "backgrounds").glob("*")):
        if f.is_file():
            # Drop the ordering number unless that collides (white has 1-white, 2-white...)
            dest = WALLS / f"{tid}-{f.name.lstrip('0123456789').lstrip('-')}"
            if dest in walls:
                dest = WALLS / f"{tid}-{f.name}"
            if not dest.exists() or dest.stat().st_mtime < f.stat().st_mtime:
                shutil.copy2(f, dest)
            walls.append(dest)
    return out, walls


if __name__ == "__main__":
    sync_repo()
    WALLS.mkdir(parents=True, exist_ok=True)
    keep = set()
    for src in sorted((REPO / "themes").iterdir()):
        if (src / "colors.toml").exists():
            out, walls = import_theme(src)
            keep.update([out, *walls])
            print(f"{src.name:18} {len(walls)} wallpapers")
    # Drop themes and wallpapers Omarchy has since removed
    for p in [*THEMES.glob("omarchy-*"), *WALLS.iterdir()]:
        if p not in keep:
            shutil.rmtree(p) if p.is_dir() else p.unlink()
    for p in GEN.glob("omarchy-*"):
        if not (THEMES / p.name).exists():
            shutil.rmtree(p)
    subprocess.run([str(HOME / ".local/bin/desk-gen")], check=True)
