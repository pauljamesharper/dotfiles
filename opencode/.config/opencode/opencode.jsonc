{
  "$schema": "https://opencode.ai/config.json",
  // Local Ollama (ollama.service, OLLAMA_CONTEXT_LENGTH=16384). CPU-only, so
  // expect it to be slow; switch models with /models.
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "deepseek-r1:8b": { "name": "DeepSeek R1 8B", "tools": true, "reasoning": true }
      }
    }
  },
  "model": "ollama/deepseek-r1:8b"
}
